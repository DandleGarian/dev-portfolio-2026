---
import Layout from "../layouts/Layout.astro";
import ProfileFrame from "../components/ProfileFrame.astro";
import { copy } from "../data/copy";

const bullets = [
  { pre: "Forging ", hi: "high-fidelity designs", post: " that prioritize technical clarity." },
  { pre: "Delivering ", hi: "precision-engineered web experiences", post: " across Shopify ecosystems." },
  { pre: "Constantly evolving ", hi: "and adapting", post: " to new technologies and design paradigms." },
];
---

<Layout title="DEV_DAN // INDEX" active="index">
  <main class="flex flex-grow items-center justify-center pt-18 lg:pt-25">
    <div
      class="mx-auto w-full max-w-content px-5 py-10 md:px-8 md:py-16 lg:px-16 lg:py-30"
    >
      <!--
        Three deliberately distinct layouts:
          < 768px  → stacked (content first, image card below)
          768–1024 → thumbnail inlined with the headline (no separate card)
          > 1024px → two-column (content left, image card right)
      -->
      <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-12">
        <!-- Content column -->
        <div class="flex flex-col gap-8 lg:flex-1">
          <!-- Top band: tablet-only thumbnail + status/headline -->
          <div class="flex items-start gap-4 md:gap-6">
            <ProfileFrame class="hidden w-24 shrink-0 md:block lg:hidden" />

            <div class="flex flex-col gap-3">
              <div
                data-reveal
                class="inline-flex w-fit items-center gap-2 border border-border bg-surface px-3 py-1"
              >
                <span class="h-2 w-2 bg-primary"></span>
                <span data-i18n="home.status" class="text-label-sm uppercase tracking-widest text-primary">
                  {copy["home.status"].professional}
                </span>
              </div>
              <h1
                class="blink-cursor text-headline-xl-mobile tracking-tighter text-foreground md:text-headline-xl"
              >
                <span data-scramble>SYSTEM_BOOT:</span><br /><span id="hero-word" data-scramble>HELLO_WORLD</span>
              </h1>
            </div>
          </div>

          <!-- Bio -->
          <div class="max-w-2xl space-y-6">
            <p data-reveal data-i18n="home.bio" class="text-body-lg text-muted">
              {copy["home.bio"].professional}
            </p>
            <div class="border-l border-border pl-4">
              <ul data-reveal-stagger class="space-y-2">
                {
                  bullets.map((b) => (
                    <li class="flex items-start gap-3 text-label-md text-foreground">
                      <span class="mt-1.5 h-1 w-1 shrink-0 bg-primary" />
                      <span>
                        {b.pre}
                        {b.hi && <span class="text-primary">{b.hi}</span>}
                        {b.post}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <!-- CTAs -->
          <div data-reveal-stagger class="flex flex-col gap-4 sm:flex-row">
            <a
              href="/work"
              class="group flex items-center justify-center gap-2 border border-primary px-8 py-4 text-label-md uppercase tracking-widest text-primary transition-colors duration-200 hover:bg-primary hover:text-on-primary"
            >
              <span>VIEW_WORK</span>
              <span
                aria-hidden="true"
                class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1"
                >arrow_forward</span
              >
            </a>
            <a
              href="/specs"
              class="flex items-center justify-center border border-border bg-surface px-8 py-4 text-label-md uppercase tracking-widest text-foreground transition-colors duration-200 hover:bg-foreground hover:text-background"
            >
              READ_LOGS
            </a>
          </div>
        </div>

        <!-- Full card: below content on mobile, right column on desktop, hidden in the tablet band -->
        <ProfileFrame
          withLabels
          class="mx-auto block w-full max-w-sm md:hidden lg:mx-0 lg:block lg:w-80 lg:shrink-0"
        />
      </div>
    </div>
  </main>

  <script>
    // Hero greeting: after the initial decode, the trailing word re-scrambles to
    // a new greeting every few seconds. scrambleText is diff-aware, so the shared
    // "HELLO_" prefix stays put and only the word decodes. Paused for reduced motion.
    import { scrambleText } from "../scripts/text-scramble";

    // EDIT ME — the rotating greetings (keep them uppercase to match the style).
    const WORDS = ["WORLD", "BUDDY", "SIR", "MADAME", "FOLKS", "BRO", "STRANGER", "LEGEND"];
    const INTERVAL = 3000;

    const el = document.getElementById("hero-word");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (el && !reduce) {
      let i = 0;
      setInterval(() => {
        i = (i + 1) % WORDS.length;
        scrambleText(el, `HELLO_${WORDS[i]}`);
      }, INTERVAL);
    }
  </script>
</Layout>
