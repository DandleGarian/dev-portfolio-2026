---
// Project detail modal — one native <dialog> (lives in the Layout so it works
// on standalone /work AND when /work is injected in the drawer). Each project's
// body is an inert <template>, cloned into the dialog on open; one live carousel
// at a time keeps the IntersectionObserver simple and future-proofs real images.
import { projects } from "../data/projects";
import CarouselSlide from "./CarouselSlide.astro";
---

<dialog id="project-modal" class="project-modal" aria-labelledby="pm-title">
  <div
    class="flex shrink-0 items-center justify-between gap-4 border-b border-border bg-surface-2 px-5 py-4"
  >
    <span id="pm-header" class="text-label-md uppercase tracking-widest text-primary">
      PROJECT // DETAILS
    </span>
    <button
      id="pm-close"
      type="button"
      aria-label="Close project details"
      class="flex items-center gap-2 text-label-md uppercase text-foreground transition-colors hover:text-primary"
    >
      <span>CLOSE</span>
      <span class="hidden text-label-sm text-muted sm:inline">[ESC]</span>
      <span aria-hidden="true" class="material-symbols-outlined">close</span>
    </button>
  </div>

  <div id="pm-body" class="grow overflow-y-auto"></div>
</dialog>

{
  projects.map((p) => (
    <template id={`pm-${p.id}`} data-name={p.name}>
      <div class="pm-carousel">
        <ul
          class="pm-track no-scrollbar flex aspect-3/4 snap-x snap-mandatory overflow-x-auto lg:aspect-video"
          tabindex="0"
          role="group"
          aria-roledescription="carousel"
          aria-label="Project screens"
        >
          {p.slides.map((slide, i) => (
            <CarouselSlide
              desktop={slide.desktop}
              mobile={slide.mobile}
              caption={slide.caption}
              title={slide.title}
              body={slide.body}
              index={i}
              total={p.slides.length}
            />
          ))}
        </ul>

        {p.slides.length > 1 && (
          <div class="pm-dots mt-4 flex justify-center gap-2" aria-hidden="true">
            {p.slides.map((_, i) => (
              <button type="button" class="pm-dot h-2 w-2 bg-border transition-colors" aria-label={`Go to image ${i + 1}`} />
            ))}
          </div>
        )}
      </div>

      <div class="flex flex-col gap-6 p-6 md:p-8">
        <div>
          <h3 id="pm-title" class="mb-2 wrap-break-word text-headline-md text-foreground">
            {p.slides[0]?.title ?? p.name}
          </h3>
          <p id="pm-desc" class="text-body-md text-muted">
            {p.slides[0]?.body ?? p.description}
          </p>
        </div>

        <dl class="grid grid-cols-1 gap-4 border-t border-border pt-6 sm:grid-cols-3">
          <div>
            <dt class="mb-1 text-label-sm uppercase text-muted">ROLE</dt>
            <dd class="text-body-md text-foreground">{p.role}</dd>
          </div>
          <div>
            <dt class="mb-1 text-label-sm uppercase text-muted">STACK</dt>
            <dd class="text-body-md text-foreground">{p.stack}</dd>
          </div>
          <div>
            <dt class="mb-1 text-label-sm uppercase text-muted">STATUS</dt>
            <dd class="text-body-md text-primary">{p.status}</dd>
          </div>
        </dl>

        {p.url && (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 border border-primary px-8 py-4 text-label-md uppercase text-primary transition-colors duration-200 hover:bg-primary hover:text-on-primary"
          >
            INITIALIZE_REMOTE_ACCESS
            <span aria-hidden="true" class="material-symbols-outlined text-[18px]">
              arrow_outward
            </span>
          </a>
        )}
      </div>
    </template>
  ))
}

<script>
  import { scrambleText } from "../scripts/text-scramble";

  const modal = document.getElementById("project-modal") as HTMLDialogElement | null;
  const body = document.getElementById("pm-body");
  const header = document.getElementById("pm-header");
  const closeBtn = document.getElementById("pm-close");

  if (modal && body) {
    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let lastTrigger: HTMLElement | null = null;
    let savedOverflow = "";
    let opening = false; // true while the open animation plays (suppresses accidental backdrop dismiss)
    let backdropPointerDown = false; // press started on the backdrop → a release there is a real dismiss
    let io: IntersectionObserver | null = null;
    let goTo: (i: number) => void = () => {};
    let getCurrent: () => number = () => 0;

    const EASE = "cubic-bezier(0.22, 1, 0.36, 1)"; // swift ease-out
    const DURATION = 220;

    // Anchor the modal's scale to the triggering card ("maximize from / minimize to" it).
    function anchorTo(el: HTMLElement) {
      const card = el.getBoundingClientRect();
      const box = modal!.getBoundingClientRect();
      modal!.style.transformOrigin = `${card.left + card.width / 2 - box.left}px ${card.top + card.height / 2 - box.top}px`;
    }

    function initCarousel() {
      if (io) {
        io.disconnect();
        io = null;
      }
      const track = body!.querySelector<HTMLElement>(".pm-track");
      const slides = [...body!.querySelectorAll<HTMLElement>(".pm-slide")];
      const dots = [...body!.querySelectorAll<HTMLButtonElement>(".pm-dot")];
      const titleEl = body!.querySelector<HTMLElement>("#pm-title");
      const descEl = body!.querySelector<HTMLElement>("#pm-desc");
      let current = 0;
      getCurrent = () => current;

      const setActive = (i: number) => {
        current = i;
        dots.forEach((d, di) => {
          const on = di === i;
          d.classList.toggle("bg-primary", on);
          d.classList.toggle("bg-border", !on);
        });
        // Per-slide detail copy (from data-pm-title / data-pm-body on the slide).
        const slide = slides[i];
        const title = slide?.dataset.pmTitle?.trim() ?? "";
        if (titleEl) {
          scrambleText(titleEl, title ? `${title} // ${String(i + 1).padStart(2, "0")}` : "");
        }
        if (descEl) descEl.textContent = slide?.dataset.pmBody ?? "";
      };
      goTo = (i: number) => {
        if (!slides.length) return;
        const idx = (i + slides.length) % slides.length; // wrap → loop
        slides[idx].scrollIntoView({
          behavior: prefersReduced ? "auto" : "smooth",
          inline: "start",
          block: "nearest",
        });
      };
      dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));
      if (slides.length) setActive(0);

      if (slides.length > 1 && track) {
        io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) setActive(slides.indexOf(e.target as HTMLElement));
            }),
          { root: track, threshold: 0.6 },
        );
        slides.forEach((s) => io!.observe(s));
      }
    }

    function open(id: string, trigger: HTMLElement | null) {
      const tpl = document.getElementById(`pm-${id}`) as HTMLTemplateElement | null;
      if (!tpl) return;
      // Recover from any in-flight close: cancel its animation and clear the
      // half-closed state, so a rapid re-open can never strand the dialog
      // open-but-invisible (is-closing left on, panel scaled to nothing).
      modal!.getAnimations().forEach((a) => a.cancel());
      modal!.classList.remove("is-closing");

      lastTrigger = trigger;
      body!.replaceChildren(tpl.content.cloneNode(true));
      body!.scrollTop = 0;
      if (header) header.textContent = `${id} // ${tpl.dataset.name ?? "DETAILS"}`;
      if (!modal!.open) {
        // showModal() throws if the dialog is already open — only call it fresh.
        savedOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";
        modal!.showModal();
      }
      initCarousel();

      if (!prefersReduced && trigger) {
        anchorTo(trigger);
        opening = true;
        const anim = modal!.animate(
          [
            { transform: "scale(0.15)", opacity: 0 },
            { transform: "scale(1)", opacity: 1 },
          ],
          { duration: DURATION, easing: EASE },
        );
        anim.onfinish = anim.oncancel = () => {
          opening = false;
        };
      }
    }

    function close() {
      // Already closed, or a close is already animating → ignore.
      if (!modal!.open || modal!.classList.contains("is-closing")) return;
      if (prefersReduced || !lastTrigger || !document.contains(lastTrigger)) {
        modal!.close();
        return;
      }
      anchorTo(lastTrigger);
      modal!.classList.add("is-closing");
      const anim = modal!.animate(
        [
          { transform: "scale(1)", opacity: 1 },
          { transform: "scale(0.15)", opacity: 0 },
        ],
        { duration: DURATION, easing: EASE, fill: "forwards" },
      );
      anim.onfinish = () => {
        modal!.classList.remove("is-closing");
        modal!.close();
      };
    }

    // Card triggers are <button data-project-id> — delegated, so they work for
    // cards on the standalone page and inside the drawer-injected content.
    document.addEventListener("click", (event) => {
      const trigger = (event.target as Element)?.closest?.<HTMLElement>("[data-project-id]");
      if (trigger?.dataset.projectId) {
        event.preventDefault();
        open(trigger.dataset.projectId, trigger);
      }
    });

    closeBtn?.addEventListener("click", () => close());
    // Backdrop dismiss: only when the press AND release both land on the backdrop
    // (not a drag/swipe out of the panel), and never during the open animation
    // (the panel is scaled small then, so the opening tap would land on backdrop).
    modal.addEventListener("pointerdown", (event) => {
      backdropPointerDown = event.target === modal;
    });
    modal.addEventListener("click", (event) => {
      const onBackdrop = event.target === modal && backdropPointerDown;
      backdropPointerDown = false;
      if (onBackdrop && !opening) close();
    });
    modal.addEventListener("cancel", (event) => {
      event.preventDefault(); // animate the close rather than the instant native one
      close();
    });

    modal.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        goTo(getCurrent() + 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        goTo(getCurrent() - 1);
      }
    });

    modal.addEventListener("close", () => {
      document.body.style.overflow = savedOverflow; // correct even with the drawer open beneath
      io?.disconnect();
      io = null;
      body!.replaceChildren();
      if (lastTrigger && document.contains(lastTrigger)) lastTrigger.focus();
      lastTrigger = null;
    });
  }
</script>
