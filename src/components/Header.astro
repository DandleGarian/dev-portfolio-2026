---
import ToneMenu from "./ToneMenu.astro";

type PageId = "index" | "work" | "specs" | "contact";

interface Props {
  active?: PageId;
}

const { active = "index" } = Astro.props;

const links: { id: PageId; label: string; href: string }[] = [
  { id: "index", label: "01 // INDEX", href: "/" },
  { id: "work", label: "02 // WORK", href: "/work" },
  { id: "specs", label: "03 // SPECS", href: "/specs" },
  { id: "contact", label: "04 // SEND", href: "/contact" },
];
---

<header
  class="fixed left-0 top-0 z-50 w-full border-b border-border bg-background/80 backdrop-blur-md transition-all duration-200"
>
  <div
    class="mx-auto flex w-full max-w-content items-center justify-between px-5 py-4 md:px-8 lg:px-16"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-headline-md font-bold tracking-tighter text-foreground"
    >
      DEV_DAN
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-6 text-label-md lg:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={active === l.id ? "page" : undefined}
            class:list={[
              "link-sweep pb-1 transition-colors",
              active === l.id
                ? "border-b border-primary text-primary"
                : "text-muted hover:text-foreground",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop trailing: tone dropdown + terminal action -->
    <div class="hidden items-center gap-3 lg:flex">
      <details class="tone-dd relative">
        <summary
          class="tone-dd-summary flex cursor-pointer items-center gap-1 p-2 text-label-md uppercase text-muted transition-colors hover:text-primary"
        >
          <span aria-hidden="true" class="material-symbols-outlined text-[18px]">translate</span>
          <span>TONE</span>
          <span aria-hidden="true" class="tone-dd-caret material-symbols-outlined text-[18px]">
            expand_more
          </span>
        </summary>
        <div
          class="tone-dd-panel absolute right-0 top-full z-50 mt-2 min-w-56 border border-border bg-surface p-2"
        >
          <ToneMenu />
        </div>
      </details>

      <button
        type="button"
        aria-label="Terminal"
        class="p-2 text-muted transition-colors hover:text-primary"
      >
        <span aria-hidden="true" class="material-symbols-outlined">terminal</span>
      </button>
    </div>

    <!-- Mobile: hamburger (the menu holds nav + tone) -->
    <button
      id="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="p-2 text-foreground transition-colors hover:text-primary lg:hidden"
    >
      <span id="nav-toggle-icon" aria-hidden="true" class="material-symbols-outlined">
        menu
      </span>
    </button>
  </div>

  <!-- Mobile menu (all pages): nav links + copy-tone selector -->
  <nav id="mobile-nav" class="mobile-nav" aria-label="Menu">
    <div>
      <div class="border-t border-border px-5 pb-4 pt-2">
        {
          links.map((l) => (
            <a
              href={l.href}
              aria-current={active === l.id ? "page" : undefined}
              class:list={[
                "block w-full p-2 text-label-md transition-colors",
                active === l.id
                  ? "border-b border-primary text-primary"
                  : "text-muted hover:bg-foreground/5 hover:text-foreground",
              ]}
            >
              {l.label}
            </a>
          ))
        }
        <div class="mt-3 border-t border-border pt-3">
          <ToneMenu />
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  const icon = document.getElementById("nav-toggle-icon");

  function setOpen(open: boolean) {
    if (!toggle || !menu || !icon) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menu.classList.toggle("is-open", open);
    icon.textContent = open ? "close" : "menu";
  }

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  // Close the menu when a nav LINK is chosen. Tone buttons aren't links, so the
  // menu stays open while switching tones (you can watch the copy decode).
  menu?.addEventListener("click", (event) => {
    if ((event.target as Element)?.closest?.("a")) setOpen(false);
  });

  // Desktop tone dropdown: native <details> handles the toggle; add light-dismiss.
  const dd = document.querySelector<HTMLDetailsElement>(".tone-dd");
  document.addEventListener("click", (event) => {
    if (dd?.open && !dd.contains(event.target as Node)) dd.open = false;
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
    if (dd?.open) dd.open = false;
  });
</script>
